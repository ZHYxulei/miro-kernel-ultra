CONFIG_MI_T1_CHIP=m
CONFIG_MCA_EXTERNAL_WIRELESS_SC96281=m
CONFIG_IR_SPI=m
CONFIG_LEDS_AW21024=m
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_MI_FP=m

CONFIG_MI_POWER_SAVE=m
CONFIG_MI_UNION_POWER=m
CONFIG_MTD=m
CONFIG_MTD_BLOCK=m
CONFIG_MTD_BLOCK2MTD=m
CONFIG_MTD_OOPS=m
CONFIG_PERF_HELPER=m

# Kernel-level baseband protection (Baseband-guard LSM)
CONFIG_BBG=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,smack,tomoyo,apparmor,bpf,baseband_guard"

# ADIOS I/O scheduler (loadable module; registered at modprobe time)
CONFIG_MQ_IOSCHED_ADIOS=m

# Full tmpfs support
CONFIG_TMPFS_INODE64=y
CONFIG_TMPFS_QUOTA=y
